# MQTT connection. Keep the real password outside version control.
VITO_DISPLAY_MQTT_HOST=192.0.2.10
VITO_DISPLAY_MQTT_PORT=1883
VITO_DISPLAY_MQTT_USER=mqtt-user
VITO_DISPLAY_MQTT_PASSWORD=change-me
VITO_DISPLAY_TOPIC_BASE=vitodens

# The two HK1 pipe sensors are read directly from the encrypted ESPHome API.
VITO_DISPLAY_PRIMARY_LABEL=VORLAUF
VITO_DISPLAY_ESPHOME_HOST=192.0.2.20
VITO_DISPLAY_ESPHOME_PORT=6053
VITO_DISPLAY_ESPHOME_NOISE_PSK=change-me
VITO_DISPLAY_ESPHOME_FLOW_KEY=3829056379
VITO_DISPLAY_ESPHOME_RETURN_KEY=2845531972
VITO_DISPLAY_ESPHOME_TIMEOUT=120

# Show a communication fault when no fresh core telemetry arrives.
VITO_DISPLAY_DATA_TIMEOUT=120
VITO_DISPLAY_SPI_HZ=40000000
